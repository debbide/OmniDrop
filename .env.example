# =============================================================================
# OmniDrop environment (copy to .env and fill secrets)
# =============================================================================

# Required: 32-byte key, base64-encoded.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OMNIDROP_DATA_KEY=

# Required: cookie / session signing secret
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public URL of the web UI (used for CORS + share links)
APP_BASE_URL=http://localhost:8080

# Host port for the web container
WEB_PORT=8080

# Set true when serving over HTTPS
COOKIE_SECURE=false

# Logging
LOG_LEVEL=info
NODE_ENV=production

# Optional concurrency / retention
MAX_DOWNLOAD_CONCURRENCY=2
MAX_UPLOAD_CONCURRENCY=3
JOB_TMP_TTL_MINUTES=60

# Optional: GitHub API token for private/rate-limited release resolution
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Image registry (production compose pulls these; override if forked)
# -----------------------------------------------------------------------------
OMNIDROP_IMAGE_API=ghcr.io/debbide/omnidrop-api:latest
OMNIDROP_IMAGE_WORKER=ghcr.io/debbide/omnidrop-worker:latest
OMNIDROP_IMAGE_WEB=ghcr.io/debbide/omnidrop-web:latest

# -----------------------------------------------------------------------------
# Local / non-Docker development only
# -----------------------------------------------------------------------------
# API_PORT=3000
# DATABASE_PATH=./data/db/omnidrop.sqlite
# TMP_DIR=./data/tmp
# ARTIFACTS_DIR=./data/artifacts
# REDIS_URL=redis://127.0.0.1:6379
# RCLONE_PATH=rclone
