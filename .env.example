# Required: 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OMNIDROP_DATA_KEY=

# Required: cookie signing secret
SESSION_SECRET=

# App
NODE_ENV=development
APP_BASE_URL=http://localhost:5173
API_PORT=3000
LOG_LEVEL=info

# Paths (dev defaults under ./data)
DATABASE_PATH=./data/db/omnidrop.sqlite
TMP_DIR=./data/tmp
ARTIFACTS_DIR=./data/artifacts
REDIS_URL=redis://127.0.0.1:6379

# Concurrency
MAX_DOWNLOAD_CONCURRENCY=2
MAX_UPLOAD_CONCURRENCY=3
JOB_TMP_TTL_MINUTES=60

# Optional: raise GitHub API rate limits when resolving releases
GITHUB_TOKEN=

# Cookie secure flag (true behind HTTPS)
COOKIE_SECURE=false
