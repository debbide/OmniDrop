# =============================================================================
# OmniDrop (copy to .env)
# =============================================================================

# Required — generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OMNIDROP_DATA_KEY=

# Required — generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public URL of this panel (CORS + share links)
APP_BASE_URL=http://localhost:8080

# Host port
WEB_PORT=8080

# true when behind HTTPS
COOKIE_SECURE=false

LOG_LEVEL=info
NODE_ENV=production

MAX_DOWNLOAD_CONCURRENCY=2
MAX_UPLOAD_CONCURRENCY=3
JOB_TMP_TTL_MINUTES=60

# Optional GitHub token for release API limits
GITHUB_TOKEN=

# Single multi-arch app image (API + Worker + Web)
OMNIDROP_IMAGE=ghcr.io/debbide/omnidrop:latest

# ----- local pnpm dev only -----
# API_PORT=3000
# DATABASE_PATH=./data/db/omnidrop.sqlite
# TMP_DIR=./data/tmp
# ARTIFACTS_DIR=./data/artifacts
# REDIS_URL=redis://127.0.0.1:6379
# RCLONE_PATH=rclone
